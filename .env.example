# ColdFusion API Configuration
NEXT_PUBLIC_CF_API_URL=http://localhost:8500
CF_API_URL=http://localhost:8500

# Database Configuration (Configure in ColdFusion Administrator)
# Database Name: decree_db
# Server: localhost
# Port: 3306
# Username: root
# Password: (leave blank for XAMPP default)

# Application Configuration
# NODE_ENV=development
# PORT=3000

# Security (Change in production!)
# SESSION_SECRET=your-secret-key-here
# JWT_SECRET=your-jwt-secret-here

# Email Configuration (Optional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-password

# Feature Flags (Optional)
# ENABLE_EMAIL_VERIFICATION=false
# ENABLE_TWO_FACTOR_AUTH=false
